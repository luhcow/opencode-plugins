{
  "name": "opencode-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for OpenCode V2 plugins.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "docs:redact": "python3 scripts/sanitize-docs.py --write",
    "licenses:sync": "node scripts/sync-licenses.mjs",
    "test": "npm test --workspaces",
    "test:reask": "npm test -w opencode-reask",
    "test:auto-rename": "npm test -w opencode-auto-rename",
    "test:compact-before": "npm test -w opencode-compact-before",
    "test:tps": "npm test -w opencode-tps",
    "test:auto-review": "npm test -w opencode-auto-review",
    "test:recall": "npm test -w opencode-recall",
    "test:a2a": "npm test -w opencode-a2a"
  },
  "devDependencies": {
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.3.0",
    "solid-js": "1.9.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=22.13.0" }
}
