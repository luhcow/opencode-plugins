{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "index.ts",
    "tui.ts",
    "rpc.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
